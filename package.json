{
  "name": "vscode-spectra-assist",
  "type": "module",
  "main": "./dist/extension.cjs",
  "displayName": "Spectra Assist",
  "description": "Language Extension for SPECTRA Calculation Input files",
  "publisher": "seanfroste",
  "version": "0.13.0",
  "repository": "https://github.com/seanfroste/vscode-spectra-assist",
  "engines": {
    "vscode": "^1.140.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "bundle": "vite build",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix --max-warnings=0",
    "format": "prettier --write . --ignore-path .prettierignore",
    "format:check": "prettier --check . --ignore-path .prettierignore",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:extension-host": "npm run bundle && node test/vscode/run.js",
    "vscode:prepublish": "npm run lint && npm run format:check && npm run test:coverage && npm run compile && npm run bundle",
    "watch": "tsc -watch -p ./"
  },
  "dependencies": {
    "vscode-languageclient": "9.0.1"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@types/node": "24.19.2",
    "@types/vscode": "1.140.0",
    "@vitest/coverage-v8": "5.0.4",
    "@vitest/eslint-plugin": "1.6.27",
    "@vscode/test-electron": "3.1.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-jsonc": "3.4.2",
    "eslint-plugin-n": "18.4.1",
    "globals": "17.13.0",
    "mocha": "12.0.3",
    "prettier": "3.9.10",
    "prettier-plugin-packagejson": "3.0.2",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vite": "8.3.4",
    "vitest": "5.0.4"
  },
  "contributes": {
    "configuration": {
      "title": "SPECTRA Language Server",
      "properties": {
        "spectrals.intellisense": {
          "type": "boolean",
          "default": true,
          "description": "Enable hover information and code completion"
        },
        "spectrals.navigation": {
          "type": "boolean",
          "default": true,
          "description": "Enable go-to-definition and find-references features"
        },
        "spectrals.diagnostics": {
          "type": "boolean",
          "default": true,
          "description": "Enable syntax validation and error reporting"
        },
        "spectrals.traceLevel": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "messages",
          "description": "Logging verbosity"
        },
        "spectrals.diagnosticsSeverity": {
          "type": "string",
          "enum": [
            "error",
            "warning",
            "info"
          ],
          "default": "error",
          "description": "Minimum diagnostic severity level"
        },
        "spectrals.maxDiagnosticsPerFile": {
          "type": "number",
          "default": 100,
          "description": "Maximum number of diagnostics per file (0 = unlimited)"
        },
        "spectrals.lsp.logging": {
          "type": "boolean",
          "default": false,
          "description": "Enable LSP communication logging to output channel"
        }
      }
    },
    "languages": [
      {
        "id": "spectra-in",
        "aliases": [
          "SPECTRA Calculation Input"
        ],
        "extensions": [
          ".in"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "spectra-in",
        "scopeName": "source.spectra-in",
        "path": "./syntaxes/spectra-in.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "spectra-in",
        "path": "./snippets/spectra-in.code-snippets"
      }
    ]
  }
}
