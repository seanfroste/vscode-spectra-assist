{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "noEmit": true,
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
  },
  "include": ["src/**/*.ts", "test/**/*.test.ts", "vite.config.ts", "vitest.config.ts"],
  "exclude": [
    "node_modules",
    "spectrals",
    "bin",
    "dist",
    "out",
    "coverage",
    ".nyc_output",
    ".vscode-test",
    ".vscode-test-web",
  ],
}
