{
  "semi": true,
  "singleQuote": true,
  "tabWidth": 2,
  "useTabs": false,
  "trailingComma": "es5",
  "printWidth": 100,
  "bracketSpacing": true,
  "arrowParens": "avoid",
  "endOfLine": "lf",
  "plugins": ["prettier-plugin-packagejson"],
  "proseWrap": "preserve",
  "embeddedLanguageFormatting": "off",
  "overrides": [
    {
      "files": ["**/*.code-snippets", "syntaxes/**/*.tmLanguage.json", "language-configuration.json"],
      "options": { "parser": "json" }
    },
    {
      "files": [".vscode/**/*.json", "tsconfig*.json", "**/*.jsonc"],
      "options": { "parser": "jsonc" }
    },
    {
      "files": [".github/**/*.yml", ".github/**/*.yaml", "**/*.yml", "**/*.yaml"],
      "options": { "parser": "yaml" }
    },
    {
      "files": [".prettierrc"],
      "options": { "parser": "json" }
    }
  ]
}
